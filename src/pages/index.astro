---
import MainLayout from '../layouts/MainLayout.astro';
import Button from '../components/Button.astro';
import PrismCard from '../components/PrismCard.astro';
import Badge from '../components/Badge.astro';
import SectionHeader from '../components/SectionHeader.astro';
import ScorecardCalculator from '../components/ScorecardCalculator.astro';
---

<MainLayout title="IT LENS — Stratégiai IT Tanácsadás & Működésfejlesztés">
  
  <!-- Hero Section -->
  <section class="relative pt-16 pb-24 md:pt-24 md:pb-36 overflow-hidden">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
      <div class="text-center max-w-3xl mx-auto space-y-6">
        
        <!-- Badge -->
        <Badge variant="cyan" pulse={true}>IT Fókusz & Átláthatóság Döntéshozóknak</Badge>

        <!-- Main Title -->
        <h1 class="text-4xl sm:text-5xl md:text-6xl font-extrabold tracking-tight text-white font-['Plus_Jakarta_Sans'] leading-tight">
          Teljes rálátás és kontroll az informatikai rendszerek felett.
        </h1>

        <!-- Subtitle -->
        <p class="text-lg sm:text-xl text-slate-300 font-normal leading-relaxed">
          Az IT Lens segít kkv-knak és intézményeknek tisztázni az IT infrastruktúra állapotát, csökkenteni a biztonsági kockázatokat és megtervezni a hatékony digitális jövőt.
        </p>

        <!-- CTAs -->
        <div class="pt-4 flex flex-col sm:flex-row items-center justify-center gap-4">
          <Button href="/audit" variant="primary" size="lg">
            Ingyenes Quick Clarity Audit (45 perc)
            <svg slot="iconRight" xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
            </svg>
          </Button>

          <Button href="/szolgaltatasok" variant="secondary" size="lg">
            Szolgáltatások megtekintése
          </Button>
        </div>

      </div>

      <!-- Hero Visual Prism Showcase -->
      <div class="mt-16 relative max-w-5xl mx-auto">
        <div class="absolute -inset-1 bg-gradient-to-r from-cyan-500 via-blue-600 to-purple-600 rounded-3xl blur-xl opacity-30 group-hover:opacity-100 transition duration-1000"></div>
        
        <div class="relative bg-[#10203d]/90 border border-blue-900/50 rounded-2xl p-6 sm:p-8 backdrop-blur-2xl shadow-2xl">
          <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
            
            <PrismCard title="Quick Clarity Audit" badge="Ingyenes" variant="accent" glow="cyan" href="/audit">
              <p class="text-sm text-slate-300 mb-4">
                45 perces strukturált konzultáció és 5 oldalas scorecard a legégetőbb IT kockázatok feltárására.
              </p>
              <div slot="footer">
                <span class="text-xs text-cyan-400 font-semibold">Időtartam: 45 perc</span>
                <span class="text-xs text-slate-300">Scorecard Riport</span>
              </div>
            </PrismCard>

            <PrismCard title="Deep System Lens Audit" badge="Stratégiai" variant="default" glow="blue" href="/audit">
              <p class="text-sm text-slate-300 mb-4">
                Több napos mélyreható infrastruktúra- és biztonsági elemzés 30+ oldalas döntéshozói cselekvési tervvel.
              </p>
              <div slot="footer">
                <span class="text-xs text-blue-300 font-semibold font-mono">250k - 500k Ft</span>
                <span class="text-xs text-slate-300">Részletes Roadmap</span>
              </div>
            </PrismCard>

            <PrismCard title="Advisory & Coaching" badge="Folyamatos" variant="glass" glow="purple" href="/szolgaltatasok/strategiai-tanacsadas">
              <p class="text-sm text-slate-300 mb-4">
                Független szakértői támogatás az IT projektvezetésben, NIS2/ISO megfelelőségben és szállítómenedzsmentben.
              </p>
              <div slot="footer">
                <span class="text-xs text-purple-300 font-semibold">Havi keret</span>
                <span class="text-xs text-slate-300">Közvetlen Alapítói SLA</span>
              </div>
            </PrismCard>

          </div>
        </div>
      </div>

    </div>
  </section>

  <!-- Interactive Calculator Section -->
  <section class="py-16 bg-[#0a1426]/90 border-t border-blue-900/40">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <ScorecardCalculator />
    </div>
  </section>

  <!-- Industry Solutions Section -->
  <section class="py-20 border-t border-blue-900/40 relative">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 space-y-12">
      
      <SectionHeader
        tag="Célcsoportok"
        title="Testreszabott megoldások szektoronként"
        description="Azonnali értékteremtés az Ön szektorának sajátosságaira szabva."
      />

      <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
        
        <PrismCard title="Közintézmények" badge="Önkormányzat / Múzeum" glow="cyan" href="/iparagak/intezmenyek">
          <p class="text-sm text-slate-300 mb-4 leading-relaxed">
            Könyvtárak és intézmények független IT stratégiai felügyelete, NIS2 és fenntartói megfelelőséggel.
          </p>
          <div slot="footer">
            <span class="text-xs text-cyan-400 font-semibold">Intézményi Útmutató →</span>
          </div>
        </PrismCard>

        <PrismCard title="Gyártás & Logisztika" badge="Kiesésmentes" glow="emerald" href="/iparagak/gyartas">
          <p class="text-sm text-slate-300 mb-4 leading-relaxed">
            Üzemi hálózatszegregáció, 3-2-1 katasztrófa-helyreállítás és zéró leállású hálózati kiépítés.
          </p>
          <div slot="footer">
            <span class="text-xs text-emerald-400 font-semibold">Gyártási IT Audit →</span>
          </div>
        </PrismCard>

        <PrismCard title="Szolgáltató KKV-k" badge="15–80 fő" glow="purple" href="/iparagak/kkv">
          <p class="text-sm text-slate-300 mb-4 leading-relaxed">
            Biztonságos M365 felhőátállás, tervezhető IT költségvetés és szállítói függetlenség.
          </p>
          <div slot="footer">
            <span class="text-xs text-purple-400 font-semibold">KKV Megoldások →</span>
          </div>
        </PrismCard>

      </div>

    </div>
  </section>

  <!-- CTA Section -->
  <section class="py-24 relative overflow-hidden border-t border-blue-900/40">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
      <div class="p-10 md:p-14 rounded-3xl bg-gradient-to-br from-[#132442] via-[#0c182e] to-[#132442] border border-cyan-500/40 shadow-2xl text-center space-y-6 relative overflow-hidden">
        
        <!-- Glow Light Element -->
        <div class="absolute -top-32 left-1/2 -translate-x-1/2 w-96 h-96 bg-cyan-500/20 rounded-full blur-3xl pointer-events-none"></div>

        <h2 class="text-3xl sm:text-4xl font-extrabold text-white font-['Plus_Jakarta_Sans'] relative z-10">
          Tegye meg az első lépést a tisztánlátás felé!
        </h2>
        
        <p class="text-base sm:text-lg text-slate-300 max-w-2xl mx-auto leading-relaxed relative z-10">
          Kérje a díjmentes 45 perces Quick Clarity Auditot, és kapjon azonnali scorecard visszajelzést IT rendszerei jelenlegi állapotáról.
        </p>

        <div class="pt-4 flex justify-center relative z-10">
          <Button href="/audit" variant="primary" size="lg">
            Kérem a díjmentes Clarity Auditot
          </Button>
        </div>

      </div>
    </div>
  </section>

</MainLayout>
