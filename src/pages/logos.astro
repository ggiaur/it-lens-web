---
import MainLayout from '../layouts/MainLayout.astro';
import SectionHeader from '../components/SectionHeader.astro';
import PrismCard from '../components/PrismCard.astro';
import Badge from '../components/Badge.astro';
---

<MainLayout title="Hivatalos Logó — IT LENS">
  <div class="py-16 md:py-24 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 space-y-16">
    
    <div class="text-center max-w-3xl mx-auto space-y-4">
      <Badge variant="cyan" pulse={true}>Kiválasztott Márkaidentitás</Badge>
      <h1 class="text-4xl sm:text-5xl font-extrabold text-white font-['Plus_Jakarta_Sans']">
        IT LENS — Hivatalos Céges Logó
      </h1>
      <p class="text-slate-300 text-lg">
        A kiválasztott 4-es számú lencse-monogram identitás.
      </p>
    </div>

    <!-- Official Chosen Logo Showcase -->
    <div class="max-w-2xl mx-auto">
      <PrismCard title="IT LENS Official Logo (Concept 4)" badge="Hivatalos Logó" glow="cyan" padding="lg" variant="accent">
        <div class="aspect-square rounded-2xl overflow-hidden mb-6 border-2 border-cyan-400 shadow-2xl">
          <img src="/logo.jpg" alt="Official IT LENS Logo" class="w-full h-full object-cover" />
        </div>
        <p class="text-sm text-slate-200 leading-relaxed text-center">
          Az <strong>ITL monogram</strong> és a körkörös lencse fókuszring ötvözete a hivatalos élesített márkaidentitás az IT LENS weboldalán és a letölthető dokumentációban.
        </p>
      </PrismCard>
    </div>

  </div>
</MainLayout>
