---
import MainLayout from '../layouts/MainLayout.astro';
import SectionHeader from '../components/SectionHeader.astro';
import PrismCard from '../components/PrismCard.astro';
import Badge from '../components/Badge.astro';
---

<MainLayout title="Concept 2 Nagy Pupillás Változatok — IT LENS">
  <div class="py-16 md:py-24 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 space-y-16">
    
    <div class="text-center max-w-3xl mx-auto space-y-4">
      <Badge variant="cyan" pulse={true}>Továbbfejlesztett 2-es Koncepció</Badge>
      <h1 class="text-4xl sm:text-5xl font-extrabold text-white font-['Plus_Jakarta_Sans']">
        IT LENS — Concept 2 Nagy Pupillával
      </h1>
      <p class="text-slate-300 text-lg">
        Az eredeti 2-es geometriai hálózati lencse megnövelt, tágabb belső pupillanyílással.
      </p>
    </div>

    <!-- Wide Pupil Options -->
    <div class="space-y-8">
      <SectionHeader
        tag="Módosított 2-es változatok"
        title="Nagy Pupillás Logó Tervek"
        description="A teljes hálózati keret és a fénycsóvák változatlanok maradtak, kizárólag a központi lencsenyílás lett tágabb."
      />

      <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
        
        <!-- Wide A -->
        <PrismCard title="Concept 2 — Nagy Pupilla A (Ring Focus)" badge="2-es Változat A" glow="cyan" padding="lg" variant="accent">
          <div class="aspect-square rounded-2xl overflow-hidden mb-6 border border-cyan-500/50 shadow-2xl">
            <img src="/logos/concept-2-wide-a.jpg" alt="Concept 2 Wide A" class="w-full h-full object-cover" />
          </div>
          <p class="text-xs text-slate-300">Tágabb, nyitott belső fókuszgyűrű és az eredeti 'IT LENS' felirat.</p>
        </PrismCard>

        <!-- Wide B -->
        <PrismCard title="Concept 2 — Nagy Pupilla B (Optical Lens)" badge="2-es Változat B" glow="blue" padding="lg" variant="accent">
          <div class="aspect-square rounded-2xl overflow-hidden mb-6 border border-blue-500/50 shadow-2xl">
            <img src="/logos/concept-2-wide-b.jpg" alt="Concept 2 Wide B" class="w-full h-full object-cover" />
          </div>
          <p class="text-xs text-slate-300">Blende szirmok és megnövelt központi kristály lencse pupilla.</p>
        </PrismCard>

      </div>
    </div>

    <!-- Original Concept 2 reference -->
    <div class="space-y-8 pt-8 border-t border-blue-900/40">
      <SectionHeader
        tag="Előzmény"
        title="Eredeti 2-es Koncepció"
        description="Amely alapján a fenti megnövelt pupillájú változatok készültek."
      />

      <div class="max-w-md mx-auto">
        <PrismCard title="Eredeti Concept 2" badge="Referencia" glow="cyan">
          <div class="aspect-square rounded-xl overflow-hidden mb-3 border border-blue-800/60 shadow-md">
            <img src="/logos/logo-2.jpg" alt="Original Logo Concept 2" class="w-full h-full object-cover" />
          </div>
        </PrismCard>
      </div>
    </div>

  </div>
</MainLayout>
