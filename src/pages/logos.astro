---
import MainLayout from '../layouts/MainLayout.astro';
import SectionHeader from '../components/SectionHeader.astro';
import PrismCard from '../components/PrismCard.astro';
import Badge from '../components/Badge.astro';
---

<MainLayout title="Logó Variációk & Kombinációk — IT LENS">
  <div class="py-16 md:py-24 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 space-y-16">
    
    <div class="text-center max-w-3xl mx-auto space-y-4">
      <Badge variant="cyan" pulse={true}>Kombinált Márkaidentitás</Badge>
      <h1 class="text-4xl sm:text-5xl font-extrabold text-white font-['Plus_Jakarta_Sans']">
        IT LENS — Kombinált Logó Tervek
      </h1>
      <p class="text-slate-300 text-lg">
        A 2-es geometriai lencseforma, a 4-es központi ITL monogram és az 1-es felirat kombinációja.
      </p>
    </div>

    <!-- Combined Options Section -->
    <div class="space-y-8">
      <SectionHeader
        tag="Kérések alapján kombinált tervek"
        title="Ajánlott Végleges Logók"
        description="A lencse fókuszában elhelyezett ITL monogram és az 'IT LENS Advisory & Technology' felirat ötvözete."
      />

      <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
        
        <!-- Combined A -->
        <PrismCard title="Kombináció A (Aperture Prism Monogram)" badge="Kombináció A" glow="cyan" padding="lg" variant="accent">
          <div class="aspect-square rounded-2xl overflow-hidden mb-6 border border-cyan-500/40 shadow-2xl">
            <img src="/logos/combined-a.jpg" alt="Combined Logo A" class="w-full h-full object-cover" />
          </div>
          <ul class="text-xs text-slate-300 space-y-2">
            <li>✔ <strong>Forma:</strong> 2-es hexagonális digitális lencse és hálózati struktúra.</li>
            <li>✔ <strong>Fókuszpont:</strong> Kisebb, szimmetrikus ITL monogram a lencse közepén.</li>
            <li>✔ <strong>Felirat:</strong> 1-es 'IT LENS Advisory & Technology' vezetői tipográfia.</li>
          </ul>
        </PrismCard>

        <!-- Combined B -->
        <PrismCard title="Kombináció B (Cybernetic ITL Focus Ring)" badge="Kombináció B" glow="blue" padding="lg" variant="accent">
          <div class="aspect-square rounded-2xl overflow-hidden mb-6 border border-blue-500/40 shadow-2xl">
            <img src="/logos/combined-b.jpg" alt="Combined Logo B" class="w-full h-full object-cover" />
          </div>
          <ul class="text-xs text-slate-300 space-y-2">
            <li>✔ <strong>Forma:</strong> Cybernetic célkereszt és koncentrikus lencseringek.</li>
            <li>✔ <strong>Fókuszpont:</strong> Kiemelt, kontrasztos 'iTL' monogram a fókuszban.</li>
            <li>✔ <strong>Felirat:</strong> Tisztán látható 'IT LENS Advisory & Technology' alsó szövegezés.</li>
          </ul>
        </PrismCard>

      </div>
    </div>

    <!-- Original Options 1, 2, 4 Reference -->
    <div class="space-y-8 pt-8 border-t border-blue-900/40">
      <SectionHeader
        tag="Referencia előzmények"
        title="Megtartott Alapkoncepciók (1, 2, 4)"
        description="Amelyekből a fenti két kombináció megszületett."
      />

      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        <PrismCard title="1. Tipográfia alapja" badge="Koncepció 1" glow="cyan">
          <div class="aspect-square rounded-xl overflow-hidden mb-3 border border-blue-800/60">
            <img src="/logos/logo-1.jpg" alt="Logo 1" class="w-full h-full object-cover" />
          </div>
        </PrismCard>

        <PrismCard title="2. Forma alapja" badge="Koncepció 2" glow="blue">
          <div class="aspect-square rounded-xl overflow-hidden mb-3 border border-blue-800/60">
            <img src="/logos/logo-2.jpg" alt="Logo 2" class="w-full h-full object-cover" />
          </div>
        </PrismCard>

        <PrismCard title="4. Monogram alapja" badge="Koncepció 4" glow="purple">
          <div class="aspect-square rounded-xl overflow-hidden mb-3 border border-blue-800/60">
            <img src="/logos/logo-4.jpg" alt="Logo 4" class="w-full h-full object-cover" />
          </div>
        </PrismCard>
      </div>
    </div>

  </div>
</MainLayout>
