---
import MainLayout from '../../layouts/MainLayout.astro';
import SectionHeader from '../../components/SectionHeader.astro';
import PrismCard from '../../components/PrismCard.astro';
import Button from '../../components/Button.astro';
import Badge from '../../components/Badge.astro';
import AuditForm from '../../components/AuditForm.astro';
---

<MainLayout 
  title="NIS2 & ISO 27001 Megfelelőségi Gyorsteszt — IT LENS"
  description="Interaktív önértékelő teszt a NIS2 kiberbiztonsági elvárások és ISO 27001 információbiztonsági alapelvek felméréséhez."
>
  <div class="py-16 md:py-24 space-y-16 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- Hero -->
    <div class="text-center max-w-3xl mx-auto space-y-6">
      <Badge variant="purple" pulse={true}>NIS2 Gyorsteszt</Badge>
      <h1 class="text-4xl sm:text-5xl font-extrabold text-white font-['Plus_Jakarta_Sans'] leading-tight">
        NIS2 & ISO 27001 Megfelelőségi Gyorsteszt
      </h1>
      <p class="text-lg text-slate-300 leading-relaxed">
        Tudja meg 3 perc alatt, hogy szervezete milyen védelmi szinttel és hiányosságokkal rendelkezik a szigorodó jogszabályi elvárások tükrében.
      </p>
    </div>

    <!-- Self Test Interactive Component -->
    <div class="max-w-3xl mx-auto border border-blue-900/50 bg-[#132442]/90 p-8 sm:p-12 rounded-3xl backdrop-blur-2xl shadow-2xl space-y-8">
      
      <div class="space-y-6">
        
        <div class="space-y-2">
          <label class="block text-sm font-semibold text-slate-200">
            1. Rendelkezik-e az intézmény/cég jóváhagyott Informatikai Biztonsági Szabályzattal (IBSZ)?
          </label>
          <select class="nis-input w-full p-2.5 rounded-xl bg-[#0c182e] border border-blue-800/60 text-sm text-slate-200">
            <option value="25">Igen, naprakész és évente felülvizsgált (25 pont)</option>
            <option value="10">Van szabályzat, de régen frissült (10 pont)</option>
            <option value="0">Nincs IBSZ (0 pont)</option>
          </select>
        </div>

        <div class="space-y-2">
          <label class="block text-sm font-semibold text-slate-200">
            2. Be van-e vezetve kötelező incidenskezelési és jelentéstételi protokoll?
          </label>
          <select class="nis-input w-full p-2.5 rounded-xl bg-[#0c182e] border border-blue-800/60 text-sm text-slate-200">
            <option value="25">Igen, zárt logolással és 24h incidens-bejelentővel (25 pont)</option>
            <option value="10">Ad-hoc módon kezeljük a hibákat (10 pont)</option>
            <option value="0">Nincs incidenskezelési terv (0 pont)</option>
          </select>
        </div>

        <div class="space-y-2">
          <label class="block text-sm font-semibold text-slate-200">
            3. Rendelkezik-e szigorú beszállítói és alvállalkozói IT kockázatértékeléssel?
          </label>
          <select class="nis-input w-full p-2.5 rounded-xl bg-[#0c182e] border border-blue-800/60 text-sm text-slate-200">
            <option value="25">Igen, minden külső beszállító auditált (25 pont)</option>
            <option value="10">Csak a fő szállítóval van SLA szerződés (10 pont)</option>
            <option value="0">Nincs ellenőrizve (0 pont)</option>
          </select>
        </div>

        <div class="space-y-2">
          <label class="block text-sm font-semibold text-slate-200">
            4. Megvalósul-e a munkatársak rendszeres kiberbiztonsági adathalászat-elleni oktatása?
          </label>
          <select class="nis-input w-full p-2.5 rounded-xl bg-[#0c182e] border border-blue-800/60 text-sm text-slate-200">
            <option value="25">Igen, évente legalább 1 alkalommal (25 pont)</option>
            <option value="10">Belépéskor tájékoztatjuk a dolgozókat (10 pont)</option>
            <option value="0">Nincs oktatás (0 pont)</option>
          </select>
        </div>

      </div>

      <div class="pt-6 border-t border-blue-900/60 flex flex-col sm:flex-row items-center justify-between gap-4">
        <div>
          <span class="text-xs text-slate-300">NIS2 Érettségi Pontszám:</span>
          <div id="nis-score" class="text-3xl font-extrabold text-purple-400 font-mono">100 / 100</div>
        </div>
        <Button href="#audit-form" variant="primary" size="md">
          Szakértői Megfelelőségi Audit Igénylése
        </Button>
      </div>

    </div>

    <AuditForm id="audit-form" />

  </div>
</MainLayout>

<script>
  function updateNisScore() {
    const selects = document.querySelectorAll<HTMLSelectElement>('.nis-input');
    let total = 0;
    selects.forEach(s => total += parseInt(s.value, 10));
    const scoreElem = document.getElementById('nis-score');
    if (scoreElem) {
      scoreElem.textContent = `${total} / 100`;
      if (total >= 75) {
        scoreElem.className = "text-3xl font-extrabold text-emerald-400 font-mono";
      } else if (total >= 50) {
        scoreElem.className = "text-3xl font-extrabold text-amber-400 font-mono";
      } else {
        scoreElem.className = "text-3xl font-extrabold text-rose-500 font-mono";
      }
    }
  }

  document.addEventListener('DOMContentLoaded', () => {
    const selects = document.querySelectorAll('.nis-input');
    selects.forEach(s => s.addEventListener('change', updateNisScore));
    updateNisScore();
  });
</script>
