---
import MainLayout from '../../layouts/MainLayout.astro';
import Button from '../../components/Button.astro';
import Badge from '../../components/Badge.astro';
import AuditForm from '../../components/AuditForm.astro';
---

<MainLayout
  title="NIS2 & ISO 27001 Felkészültségi Önteszt — IT LENS"
  description="Tájékozódó önértékelő teszt a kiberbiztonsági kontrollok felkészültségének áttekintéséhez."
>
  <div class="py-16 md:py-24 space-y-16 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center max-w-3xl mx-auto space-y-6">
      <Badge variant="purple" pulse={true}>Tájékozódó önteszt</Badge>
      <h1 class="text-4xl sm:text-5xl font-extrabold text-white leading-tight">NIS2 & ISO 27001 felkészültségi önteszt</h1>
      <p class="text-lg text-slate-300 leading-relaxed">
        Négy rövid kérdés segítségével kapjon első, nem teljes körű képet néhány alapvető kiberbiztonsági kontroll állapotáról.
      </p>
    </div>

    <div class="max-w-3xl mx-auto border border-blue-900/50 bg-[#132442]/90 p-8 sm:p-12 rounded-3xl backdrop-blur-2xl shadow-2xl space-y-8">
      <div class="rounded-xl border border-amber-500/30 bg-amber-950/20 p-4 text-sm text-amber-100">
        Ez az önteszt nem állapít meg NIS2- vagy ISO 27001-megfelelőséget, nem helyettesít jogi elemzést, hatósági vizsgálatot vagy akkreditált tanúsítást. A pontszám kizárólag tájékozódási célú.
      </div>

      <div class="space-y-6">
        <div class="space-y-2">
          <label class="block text-sm font-semibold text-slate-200">1. Rendelkezik-e a szervezet jóváhagyott és rendszeresen felülvizsgált információbiztonsági szabályozással?</label>
          <select class="nis-input w-full p-2.5 rounded-xl bg-[#0c182e] border border-blue-800/60 text-sm text-slate-200">
            <option value="25">Igen, naprakész és rendszeresen felülvizsgált (25 pont)</option>
            <option value="10">Van, de régen frissült (10 pont)</option>
            <option value="0">Nincs dokumentált szabályozás (0 pont)</option>
          </select>
        </div>
        <div class="space-y-2">
          <label class="block text-sm font-semibold text-slate-200">2. Van-e dokumentált incidenskezelési és jelentési folyamat?</label>
          <select class="nis-input w-full p-2.5 rounded-xl bg-[#0c182e] border border-blue-800/60 text-sm text-slate-200">
            <option value="25">Igen, dokumentált és gyakorolt folyamat (25 pont)</option>
            <option value="10">Részben / ad hoc módon működik (10 pont)</option>
            <option value="0">Nincs dokumentált folyamat (0 pont)</option>
          </select>
        </div>
        <div class="space-y-2">
          <label class="block text-sm font-semibold text-slate-200">3. Történik-e beszállítói és alvállalkozói IT-kockázatok rendszeres értékelése?</label>
          <select class="nis-input w-full p-2.5 rounded-xl bg-[#0c182e] border border-blue-800/60 text-sm text-slate-200">
            <option value="25">Igen, dokumentált és rendszeres (25 pont)</option>
            <option value="10">Csak részben vagy a fő szállítóknál (10 pont)</option>
            <option value="0">Nincs ilyen ellenőrzés (0 pont)</option>
          </select>
        </div>
        <div class="space-y-2">
          <label class="block text-sm font-semibold text-slate-200">4. Történik-e rendszeres kiberbiztonsági tudatossági oktatás?</label>
          <select class="nis-input w-full p-2.5 rounded-xl bg-[#0c182e] border border-blue-800/60 text-sm text-slate-200">
            <option value="25">Igen, rendszeresen és dokumentáltan (25 pont)</option>
            <option value="10">Csak alkalmanként / belépéskor (10 pont)</option>
            <option value="0">Nincs rendszeres oktatás (0 pont)</option>
          </select>
        </div>
      </div>

      <div class="pt-6 border-t border-blue-900/60 flex flex-col sm:flex-row items-center justify-between gap-4">
        <div>
          <span class="text-xs text-slate-300">Tájékozódó felkészültségi pontszám:</span>
          <div id="nis-score" class="text-3xl font-extrabold text-purple-400 font-mono">100 / 100</div>
        </div>
        <Button href="#audit-form" variant="primary" size="md">Részletes állapotfelmérés igénylése</Button>
      </div>
    </div>

    <AuditForm id="audit-form" />
  </div>
</MainLayout>

<script>
  function updateNisScore() {
    const selects = document.querySelectorAll<HTMLSelectElement>('.nis-input');
    let total = 0;
    selects.forEach(s => total += parseInt(s.value, 10));
    const scoreElem = document.getElementById('nis-score');
    if (!scoreElem) return;
    scoreElem.textContent = `${total} / 100`;
    if (total >= 75) scoreElem.className = "text-3xl font-extrabold text-emerald-400 font-mono";
    else if (total >= 50) scoreElem.className = "text-3xl font-extrabold text-amber-400 font-mono";
    else scoreElem.className = "text-3xl font-extrabold text-rose-500 font-mono";
  }

  document.addEventListener('DOMContentLoaded', () => {
    document.querySelectorAll('.nis-input').forEach(s => s.addEventListener('change', updateNisScore));
    updateNisScore();
  });
</script>
