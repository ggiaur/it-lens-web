---
import MainLayout from '../../layouts/MainLayout.astro';
import SectionHeader from '../../components/SectionHeader.astro';
import PrismCard from '../../components/PrismCard.astro';
import Button from '../../components/Button.astro';
import Badge from '../../components/Badge.astro';
import AuditForm from '../../components/AuditForm.astro';
---

<MainLayout 
  title="Quick Clarity Audit Scorecard Minta — IT LENS"
  description="Anonimizált riportrészlet és pontozott vezetői scorecard a 45 perces Quick Clarity Audit eredményeiről."
>
  <div class="py-16 md:py-24 space-y-16 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- Hero -->
    <div class="text-center max-w-3xl mx-auto space-y-6">
      <Badge variant="cyan" pulse={true}>Scorecard Minta</Badge>
      <h1 class="text-4xl sm:text-5xl font-extrabold text-white font-['Plus_Jakarta_Sans'] leading-tight">
        Quick Clarity Audit Scorecard
      </h1>
      <p class="text-lg text-slate-300 leading-relaxed">
        Az alábbi minta bemutatja azt az 5 oldalas, vezetői nyelven íródott kiértékelést, amelyet az ingyenes 45 perces audit végén kap a megrendelő.
      </p>
    </div>

    <!-- Scorecard Preview Card -->
    <div class="max-w-4xl mx-auto border border-cyan-500/30 rounded-3xl p-8 sm:p-12 bg-slate-950/90 backdrop-blur-2xl shadow-2xl space-y-8">
      
      <div class="flex flex-col sm:flex-row items-start sm:items-center justify-between border-b border-slate-800 pb-6 gap-4">
        <div>
          <span class="text-xs font-mono uppercase text-cyan-400 tracking-wider">Anonimizált Példa Riport</span>
          <h2 class="text-2xl font-bold text-white">Vezetői Értékelő Mátrix</h2>
        </div>
        <div class="text-right">
          <span class="text-xs text-slate-400">Átlagos Érettségi Pontszám</span>
          <div class="text-3xl font-extrabold text-amber-400 font-mono">62 / 100</div>
        </div>
      </div>

      <div class="space-y-6">
        
        <!-- Pillar 1 -->
        <div class="space-y-2">
          <div class="flex justify-between text-sm">
            <span class="font-semibold text-slate-200">1. IT Biztonság & Zsarolóvírus Védelem</span>
            <span class="font-mono text-cyan-400 font-bold">55% (Közepes kockázat)</span>
          </div>
          <div class="w-full h-3 rounded-full bg-slate-900 overflow-hidden">
            <div class="h-full bg-cyan-400 w-[55%]"></div>
          </div>
          <p class="text-xs text-slate-400">Megállapítás: A mentések léteznek, de a fizikai elkülönítés (3-2-1) és a tesztelt visszaállítás hiányzik.</p>
        </div>

        <!-- Pillar 2 -->
        <div class="space-y-2">
          <div class="flex justify-between text-sm">
            <span class="font-semibold text-slate-200">2. Rendszerdokumentáció & Leltár</span>
            <span class="font-mono text-rose-400 font-bold">30% (Magas kockázat)</span>
          </div>
          <div class="w-full h-3 rounded-full bg-slate-900 overflow-hidden">
            <div class="h-full bg-rose-500 w-[30%]"></div>
          </div>
          <p class="text-xs text-slate-400">Megállapítás: A rendszerleírások elavultak; a hozzáférési jelszavak csak 1 kolléga fejében vannak meg.</p>
        </div>

        <!-- Pillar 3 -->
        <div class="space-y-2">
          <div class="flex justify-between text-sm">
            <span class="font-semibold text-slate-200">3. Szállítói Függőség & Garanciák</span>
            <span class="font-mono text-emerald-400 font-bold">80% (Alacsony kockázat)</span>
          </div>
          <div class="w-full h-3 rounded-full bg-slate-900 overflow-hidden">
            <div class="h-full bg-emerald-400 w-[80%]"></div>
          </div>
          <p class="text-xs text-slate-400">Megállapítás: Stabil külső karbantartási szerződések, de hiányzik a független felülvizsgálat.</p>
        </div>

        <!-- Pillar 4 -->
        <div class="space-y-2">
          <div class="flex justify-between text-sm">
            <span class="font-semibold text-slate-200">4. Megfelelőség (NIS2 / ISO elvek)</span>
            <span class="font-mono text-amber-400 font-bold">45% (Fejlesztendő)</span>
          </div>
          <div class="w-full h-3 rounded-full bg-slate-900 overflow-hidden">
            <div class="h-full bg-amber-400 w-[45%]"></div>
          </div>
          <p class="text-xs text-slate-400">Megállapítás: Nincs dokumentált incidenskezelési és jogosultság-felülvizsgálati szabályzat.</p>
        </div>

      </div>

      <div class="pt-6 border-t border-slate-800 text-center space-y-4">
        <h3 class="text-xl font-bold text-white">Szeretne saját szervezetére szabott Scorecardot?</h3>
        <Button href="#audit-form" variant="primary" size="lg">
          Kérem az ingyenes Quick Clarity Auditot
        </Button>
      </div>

    </div>

    <AuditForm id="audit-form" />

  </div>
</MainLayout>
