---
import MainLayout from '../../layouts/MainLayout.astro';
import SectionHeader from '../../components/SectionHeader.astro';
import PrismCard from '../../components/PrismCard.astro';
import Button from '../../components/Button.astro';
import Badge from '../../components/Badge.astro';
import AuditForm from '../../components/AuditForm.astro';
---

<MainLayout 
  title="IT Tanácsadás Szolgáltató KKV-knak — IT LENS"
  description="Kiszámítható IT működés és digitális hatékonyság 15-80 fős szolgáltató vállalkozásoknak."
>
  <div class="py-16 md:py-24 space-y-20 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- Hero -->
    <div class="text-center max-w-3xl mx-auto space-y-6">
      <Badge variant="blue" pulse={true}>Szolgáltató KKV</Badge>
      <h1 class="text-4xl sm:text-5xl font-extrabold text-white font-['Plus_Jakarta_Sans'] leading-tight">
        Kiszámítható IT háttér a növekvő szolgáltató cégeknek.
      </h1>
      <p class="text-lg text-slate-300 leading-relaxed">
        15–80 fős szolgáltató KKV-knak (jogi, pénzügyi, tanácsadó és kereskedelmi cégeknek), ahol az ügyféladatok biztonsága és a hibrid munkavégzés elengedhetetlen.
      </p>
      <div class="pt-4 flex flex-col sm:flex-row items-center justify-center gap-4">
        <Button href="#audit-form" variant="primary" size="lg">
          KKV Clarity Audit Igénylése
        </Button>
      </div>
    </div>

    <!-- Pillars -->
    <div class="space-y-12">
      <SectionHeader
        tag="Előnyök"
        title="Mit nyer a vállalkozás?"
        description="Független szakértelem és kiszámítható IT büdzsé."
      />

      <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
        <PrismCard title="M365 & SharePoint Rend" glow="blue">
          <p class="text-sm text-slate-300">
            Közös, biztonságos dokumentumtár minden kollégának, MFA védelemmel és szabályozott hozzáférésekkel.
          </p>
        </PrismCard>

        <PrismCard title="Tervezhető Költségvetés" glow="blue">
          <p class="text-sm text-slate-300">
            3-5 éves fejlesztési és eszközcsere terv, meglepetésszerű számlák nélkül.
          </p>
        </PrismCard>

        <PrismCard title="Beszállítói Függetlenség" glow="blue">
          <p class="text-sm text-slate-300">
            Független IT-igazgatói kontroll a külső üzemeltetői és szoftveres árajánlatok felett.
          </p>
        </PrismCard>
      </div>
    </div>

    <AuditForm id="audit-form" />

  </div>
</MainLayout>
