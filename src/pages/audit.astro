---
import MainLayout from '../layouts/MainLayout.astro';
import SectionHeader from '../components/SectionHeader.astro';
import AuditTable from '../components/AuditTable.astro';
import AuditForm from '../components/AuditForm.astro';
import PrismCard from '../components/PrismCard.astro';
import Badge from '../components/Badge.astro';
---

<MainLayout
  title="IT Audit & Clarity Scorecard — IT LENS"
  description="Quick Clarity Audit és Deep System Lens Audit kkv-k és közintézmények számára. Bizonyíték-alapú helyzetkép és fejlesztési roadmap."
>
  <div class="py-16 md:py-24 space-y-24 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center max-w-3xl mx-auto space-y-6">
      <Badge variant="cyan" pulse={true}>Tiszta Rálátás & Kontroll</Badge>
      <h1 class="text-4xl sm:text-5xl md:text-6xl font-extrabold text-white leading-tight tracking-tight">
        Lássa pontosan, hol tart az IT infrastruktúrája.
      </h1>
      <p class="text-lg text-slate-300 leading-relaxed">
        Az IT Audit célja a technikai és működési kockázatok bizonyíték-alapú feltárása és egy priorizált fejlesztési terv elkészítése — döntéshozói nyelven.
      </p>
    </div>

    <div class="space-y-8">
      <SectionHeader tag="Ajánlataink" title="Válassza ki az Önnek megfelelő audit szintet"
        description="A gyors helyzetértékeléstől a mélyebb, engedélyezett scope alapján végzett vizsgálatig." />
      <AuditTable />
    </div>

    <div class="space-y-12">
      <SectionHeader tag="Módszertan" title="Az audit fő vizsgálati dimenziói"
        description="A vizsgálat mélységét mindig a jóváhagyott scope, az elérhető bizonyíték és a választott szolgáltatás határozza meg." />

      <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
        <PrismCard title="1. IT Biztonság & Mentés" badge="Kritikus" glow="cyan">
          <p class="text-sm text-slate-300">Mentési, hozzáférési és védelmi kontrollok állapotának felmérése, a rendelkezésre álló bizonyítékok alapján.</p>
        </PrismCard>
        <PrismCard title="2. Dokumentáció & Tudás" badge="Üzemeltetés" glow="blue">
          <p class="text-sm text-slate-300">Leltárak, rendszerleírások, felelősségek és működési dokumentáció áttekintése.</p>
        </PrismCard>
        <PrismCard title="3. Folyamatok & Szolgáltatás" badge="Működés" glow="purple">
          <p class="text-sm text-slate-300">Incidens-, változás-, szolgáltatási és beszállítói folyamatok vizsgálata.</p>
        </PrismCard>
        <PrismCard title="4. NIS2 / ISO 27001 felkészültség" badge="Keretrendszer" glow="emerald">
          <p class="text-sm text-slate-300">Hiány- és felkészültségi elemzés releváns követelmények és kontrollkeretek mentén. Nem hatósági vagy akkreditált tanúsítás.</p>
        </PrismCard>
        <PrismCard title="5. Kapacitás & Jövőkép" badge="Fejlődés" glow="cyan">
          <p class="text-sm text-slate-300">Költség-, architektúra- és automatizációs fejlesztési lehetőségek értékelése.</p>
        </PrismCard>
        <PrismCard title="Vezetői összefoglaló" badge="Deliverable" glow="blue">
          <p class="text-sm text-slate-300">Pontozott helyzetkép, bizonyítékkal alátámasztott megállapítások és prioritási sorrendbe állított teendők.</p>
        </PrismCard>
      </div>

      <div class="rounded-2xl border border-amber-500/30 bg-amber-950/20 p-5 text-sm text-amber-100">
        Az IT LENS audit és önellenőrző tartalmai nem minősülnek jogi tanácsadásnak, hatósági megfelelőségi határozatnak vagy akkreditált ISO/NIS2 tanúsításnak.
      </div>
    </div>

    <div><AuditForm id="audit-form" /></div>
  </div>
</MainLayout>
