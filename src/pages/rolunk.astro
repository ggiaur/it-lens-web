---
import MainLayout from '../layouts/MainLayout.astro';
import SectionHeader from '../components/SectionHeader.astro';
import PrismCard from '../components/PrismCard.astro';
import Button from '../components/Button.astro';
import Badge from '../components/Badge.astro';
---

<MainLayout 
  title="Rólunk — IT LENS"
  description="Független stratégiai IT tanácsadás. 20+ év IT tapasztalat, intézményi IT vezetői hátterű alapítói elkötelezettséggel."
>
  <div class="py-16 md:py-24 space-y-20 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- Hero -->
    <div class="text-center max-w-3xl mx-auto space-y-6">
      <Badge variant="cyan" pulse={true}>Alapítói Pozicionálás</Badge>
      <h1 class="text-4xl sm:text-5xl font-extrabold text-white font-['Plus_Jakarta_Sans'] leading-tight">
        Stratégiai partner a cégvezetés és a fenntartó mellett.
      </h1>
      <p class="text-lg text-slate-300 leading-relaxed">
        Az IT Lens nem klasszikus karbantartó cég vagy dobozos szoftverértékesítő. Független tanácsadóként és stratégiai partnerként támogatjuk a döntéshozókat.
      </p>
    </div>

    <!-- Core Values & Commitments -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
      
      <PrismCard title="Függetlenségi Garancia" badge="Elv" glow="cyan" padding="lg">
        <p class="text-sm text-slate-300">
          Nem értékesítünk saját hardvereket és nem elkötelezettek vagyunk egyetlen viszonteladói hálózathoz sem. Kizárólag a Megrendelő érdekeit képviseljük.
        </p>
      </PrismCard>

      <PrismCard title="20+ Év IT Tapasztalat" badge="Tapasztalat" glow="blue" padding="lg">
        <p class="text-sm text-slate-300">
          Gyakorlati, több telephelyes intézményi IT-vezetői hátterű szaktudás, amely garantálja, hogy érthető üzleti nyelven beszélünk.
        </p>
      </PrismCard>

      <PrismCard title="Közvetlen Alapítói SLA" badge="Garantált" glow="purple" padding="lg">
        <p class="text-sm text-slate-300">
          Minden ügyfél közvetlenül az alapító tanácsadóval áll kapcsolatban. Munkaidőben &lt; 1 munkanapos válaszidő-garanciával.
        </p>
      </PrismCard>

    </div>

    <!-- CTA -->
    <div class="text-center pt-8">
      <PrismCard variant="accent" glow="cyan" padding="lg" class="max-w-3xl mx-auto space-y-4">
        <h3 class="text-2xl font-bold text-white">Beszéljük át szervezetének IT kihívásait!</h3>
        <p class="text-slate-300 max-w-xl mx-auto">
          Foglaljon időpontot egy 45 perces díjmentes Executive Clarity konzultációra.
        </p>
        <Button href="/audit" variant="primary" size="lg">
          Konzultáció Igénylése
        </Button>
      </PrismCard>
    </div>

  </div>
</MainLayout>
