---
import Button from './Button.astro';
import Badge from './Badge.astro';
---

<div class="relative rounded-3xl border border-cyan-500/30 bg-slate-950/90 p-8 sm:p-12 backdrop-blur-2xl shadow-2xl overflow-hidden">
  <!-- Glowing Background spot -->
  <div class="absolute -top-32 left-1/2 -translate-x-1/2 w-96 h-96 bg-cyan-500/15 rounded-full blur-3xl pointer-events-none"></div>

  <div class="max-w-3xl mx-auto space-y-8 relative z-10 text-center">
    
    <div class="space-y-3">
      <Badge variant="cyan" pulse={true}>Interaktív Önértékelő</Badge>
      <h3 class="text-3xl font-extrabold text-white font-['Plus_Jakarta_Sans']">
        Számítsa ki szervezetének IT Érettségi Pontszámát!
      </h3>
      <p class="text-sm text-slate-300">
        Válaszoljon 5 gyors kérdésre, és kapjon azonnali visszajelzést a biztonsági és működési kockázatokról.
      </p>
    </div>

    <!-- Calculator Questions -->
    <div id="calculator-app" class="space-y-6 text-left bg-slate-900/80 p-6 sm:p-8 rounded-2xl border border-slate-800">
      
      <!-- Question 1 -->
      <div class="space-y-2">
        <label class="block text-sm font-semibold text-slate-200">
          1. Rendelkezik-e fizikailag vagy felhőben elkülönített, mentett adatmentéssel?
        </label>
        <select class="calc-input w-full p-2.5 rounded-xl bg-slate-950 border border-slate-700 text-sm text-slate-200">
          <option value="20">Igen, és rendszeresen teszteljük a visszaállítást (20 pont)</option>
          <option value="10">Igen, van mentés, de nem teszteljük (10 pont)</option>
          <option value="0">Nem tudom / Nincs mentés (0 pont)</option>
        </select>
      </div>

      <!-- Question 2 -->
      <div class="space-y-2">
        <label class="block text-sm font-semibold text-slate-200">
          2. Használnak-e kétlépcsős azonosítást (MFA) a céges levelezésben?
        </label>
        <select class="calc-input w-full p-2.5 rounded-xl bg-slate-950 border border-slate-700 text-sm text-slate-200">
          <option value="20">Minden munkatársnak kötelező (20 pont)</option>
          <option value="10">Csak a vezetőknek / egyes felhasználóknak (10 pont)</option>
          <option value="0">Nem hasznáunk MFA-t (0 pont)</option>
        </select>
      </div>

      <!-- Question 3 -->
      <div class="space-y-2">
        <label class="block text-sm font-semibold text-slate-200">
          3. Létezik-e naprakész hardver- és szoftverleltár, jelszókezelővel?
        </label>
        <select class="calc-input w-full p-2.5 rounded-xl bg-slate-950 border border-slate-700 text-sm text-slate-200">
          <option value="20">Igen, teljes és dokumentált (20 pont)</option>
          <option value="10">Részben van meg (10 pont)</option>
          <option value="0">Nincs dokumentáció, 1 kolléga fejében van meg (0 pont)</option>
        </select>
      </div>

      <!-- Question 4 -->
      <div class="space-y-2">
        <label class="block text-sm font-semibold text-slate-200">
          4. Van-e kiszámítható 3-5 éves IT fejlesztési és költségvetési terv?
        </label>
        <select class="calc-input w-full p-2.5 rounded-xl bg-slate-950 border border-slate-700 text-sm text-slate-200">
          <option value="20">Igen, előre tervezett büdzsével (20 pont)</option>
          <option value="10">Ad-hoc jelleggel tervezünk (10 pont)</option>
          <option value="0">Nincs terv, csak meglepetésszerű számlák vannak (0 pont)</option>
        </select>
      </div>

      <!-- Question 5 -->
      <div class="space-y-2">
        <label class="block text-sm font-semibold text-slate-200">
          5. Szét van-e választva a vendég Wi-Fi a belső irodai/adatbázis hálózattól?
        </label>
        <select class="calc-input w-full p-2.5 rounded-xl bg-slate-950 border border-slate-700 text-sm text-slate-200">
          <option value="20">Igen, teljesen szegregált (20 pont)</option>
          <option value="10">Nem tudom biztosan (10 pont)</option>
          <option value="0">Ugyanazon a hálózaton vannak (0 pont)</option>
        </select>
      </div>

      <div class="pt-4 border-t border-slate-800 flex flex-col sm:flex-row items-center justify-between gap-4">
        <div>
          <span class="text-xs text-slate-400">Kalkulált Érettségi Pontszám:</span>
          <div id="calc-score" class="text-3xl font-extrabold text-cyan-400 font-mono">100 / 100</div>
        </div>
        <Button href="/audit" variant="primary" size="md">
          Pontos Szakértői Audit Igénylése
        </Button>
      </div>

    </div>

  </div>
</div>

<script>
  function updateScore() {
    const selects = document.querySelectorAll<HTMLSelectElement>('.calc-input');
    let total = 0;
    selects.forEach(select => {
      total += parseInt(select.value, 10);
    });
    const scoreElem = document.getElementById('calc-score');
    if (scoreElem) {
      scoreElem.textContent = `${total} / 100`;
      if (total >= 80) {
        scoreElem.className = "text-3xl font-extrabold text-emerald-400 font-mono";
      } else if (total >= 50) {
        scoreElem.className = "text-3xl font-extrabold text-amber-400 font-mono";
      } else {
        scoreElem.className = "text-3xl font-extrabold text-rose-500 font-mono";
      }
    }
  }

  document.addEventListener('DOMContentLoaded', () => {
    const selects = document.querySelectorAll('.calc-input');
    selects.forEach(select => {
      select.addEventListener('change', updateScore);
    });
    updateScore();
  });
</script>
