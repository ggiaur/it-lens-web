---
interface Props {
  variant?: 'cyan' | 'emerald' | 'purple' | 'amber' | 'blue';
  size?: 'sm' | 'md';
  pulse?: boolean;
  class?: string;
  [key: string]: any;
}

const {
  variant = 'cyan',
  size = 'md',
  pulse = false,
  class: className = '',
  ...restProps
} = Astro.props;

const sizeStyles = {
  sm: "px-2.5 py-0.5 text-[11px] gap-1.5",
  md: "px-3.5 py-1 text-xs gap-2"
};

const variantStyles = {
  cyan: "bg-cyan-950/80 text-cyan-300 border-cyan-500/40 shadow-cyan-950/40",
  emerald: "bg-emerald-950/80 text-emerald-300 border-emerald-500/40 shadow-emerald-950/40",
  purple: "bg-purple-950/80 text-purple-300 border-purple-500/40 shadow-purple-950/40",
  amber: "bg-amber-950/80 text-amber-300 border-amber-500/40 shadow-amber-950/40",
  blue: "bg-blue-950/80 text-blue-300 border-blue-500/40 shadow-blue-950/40"
};

const dotColors = {
  cyan: "bg-cyan-400",
  emerald: "bg-emerald-400",
  purple: "bg-purple-400",
  amber: "bg-amber-400",
  blue: "bg-blue-400"
};
---

<span
  class:list={[
    "inline-flex items-center rounded-full border font-semibold tracking-wide uppercase shadow-md backdrop-blur-md",
    sizeStyles[size],
    variantStyles[variant],
    className
  ]}
  {...restProps}
>
  {pulse && (
    <span class="relative flex h-2 w-2">
      <span class:list={["animate-ping absolute inline-flex h-full w-full rounded-full opacity-75", dotColors[variant]]}></span>
      <span class:list={["relative inline-flex rounded-full h-2 w-2", dotColors[variant]]}></span>
    </span>
  )}
  <slot />
</span>
