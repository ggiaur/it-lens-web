---
import '../styles/global.css';
import Button from '../components/Button.astro';

interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
}

const {
  title = "IT LENS — Stratégiai IT Tanácsadás & Működésfejlesztés",
  description = "Átlátható, biztonságos és automatizált IT infrastruktúra és stratégiai tanácsadás kkv-k és közintézmények számára.",
  ogImage = "/og-image.jpg"
} = Astro.props;

const currentYear = new Date().getFullYear();
---

<!DOCTYPE html>
<html lang="hu" class="dark scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />

    <!-- SEO Meta Tags -->
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content="index, follow" />

    <!-- Open Graph / Social -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />

    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&family=Plus+Jakarta+Sans:wght@600;700;800&display=swap" rel="stylesheet" />
  </head>
  <body class="bg-[#0c182e] text-slate-200 min-h-screen flex flex-col antialiased selection:bg-cyan-500/30 selection:text-cyan-200">
    <!-- Grid Overlay Effect -->
    <div class="fixed inset-0 bg-tech-grid opacity-40 pointer-events-none z-0"></div>
    
    <!-- Top Ambient Light Glow -->
    <div class="fixed top-0 left-1/2 -translate-x-1/2 w-[800px] h-[350px] bg-gradient-to-b from-cyan-500/20 via-blue-600/15 to-transparent blur-3xl rounded-full pointer-events-none z-0"></div>

    <!-- Navigation Header -->
    <header class="sticky top-0 z-50 w-full backdrop-blur-xl bg-[#0c182e]/85 border-b border-blue-900/40 transition-all">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-20 flex items-center justify-between">
        
        <!-- Logo -->
        <a href="/" class="flex items-center gap-3 group text-slate-100 no-underline">
          <div class="relative w-10 h-10 rounded-xl overflow-hidden shadow-lg shadow-cyan-500/20 group-hover:shadow-cyan-400/40 transition-all duration-300 border border-cyan-400/30">
            <img src="/logo.jpg" alt="IT LENS Logo" class="w-full h-full object-cover" />
          </div>
          <div class="flex flex-col">
            <span class="font-extrabold text-xl tracking-tight text-white font-['Plus_Jakarta_Sans']">
              IT <span class="text-transparent bg-clip-text bg-gradient-to-r from-cyan-400 to-blue-400">LENS</span>
            </span>
            <span class="text-[10px] text-slate-400 uppercase tracking-widest -mt-1 font-medium">Advisory & Technology</span>
          </div>
        </a>

        <!-- Desktop Navigation -->
        <nav class="hidden md:flex items-center gap-8">
          <a href="/" class="text-sm font-medium text-slate-300 hover:text-cyan-300 transition-colors">Főoldal</a>
          <a href="/szolgaltatasok" class="text-sm font-medium text-slate-300 hover:text-cyan-300 transition-colors">Szolgáltatások</a>
          <a href="/audit" class="text-sm font-medium text-slate-300 hover:text-cyan-300 transition-colors">IT Audit</a>
          <a href="/kapcsolat" class="text-sm font-medium text-slate-300 hover:text-cyan-300 transition-colors">Kapcsolat</a>
        </nav>

        <!-- Header CTA -->
        <div class="flex items-center gap-4">
          <Button href="/audit" variant="primary" size="sm">
            Quick Clarity Audit
          </Button>
        </div>

      </div>
    </header>

    <!-- Main Content Area -->
    <main class="relative z-10 flex-grow">
      <slot />
    </main>

    <!-- Footer -->
    <footer class="relative z-10 border-t border-blue-900/40 bg-[#081226]/95 backdrop-blur-md mt-24">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12 md:py-16">
        <div class="grid grid-cols-1 md:grid-cols-4 gap-10">
          
          <!-- Column 1: Brand -->
          <div class="md:col-span-2 space-y-4">
            <div class="flex items-center gap-3">
              <div class="w-8 h-8 rounded-lg overflow-hidden border border-cyan-400/30">
                <img src="/logo.jpg" alt="IT LENS Logo" class="w-full h-full object-cover" />
              </div>
              <span class="font-extrabold text-lg tracking-tight text-white">IT LENS</span>
            </div>
            <p class="text-sm text-slate-400 max-w-md leading-relaxed">
              Stratégiai IT tanácsadás, infrastruktúra felmérés és célzott digitális fejlesztés. Tisztánlátás és kontroll a döntéshozók kezében.
            </p>
            <div class="inline-flex items-center gap-2 px-3 py-1 rounded-md bg-slate-900 border border-slate-800 text-xs text-slate-300">
              <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
              ISO 27001 & NIS2 módszertani elvek alapján
            </div>
          </div>

          <!-- Column 2: Nav Links -->
          <div>
            <h4 class="text-xs font-semibold uppercase tracking-wider text-slate-300 mb-4">Navigáció</h4>
            <ul class="space-y-2.5 text-sm text-slate-400">
              <li><a href="/" class="hover:text-cyan-400 transition-colors">Főoldal</a></li>
              <li><a href="/szolgaltatasok" class="hover:text-cyan-400 transition-colors">Szolgáltatások</a></li>
              <li><a href="/audit" class="hover:text-cyan-400 transition-colors">Clarity Scorecard & Audit</a></li>
              <li><a href="/kapcsolat" class="hover:text-cyan-400 transition-colors">Kapcsolatfelvétel</a></li>
            </ul>
          </div>

          <!-- Column 3: Contact & Info -->
          <div>
            <h4 class="text-xs font-semibold uppercase tracking-wider text-slate-300 mb-4">Kapcsolat</h4>
            <ul class="space-y-2.5 text-sm text-slate-400">
              <li>Domain: <span class="text-slate-200">it-lens.hu</span></li>
              <li>Fókusz: Közintézmények & KKV IT tanácsadás</li>
              <li>Status: <span class="text-cyan-400 font-medium">Phase 1 Execution</span></li>
            </ul>
          </div>

        </div>

        <div class="border-t border-slate-800/60 mt-12 pt-8 flex flex-col sm:flex-row items-center justify-between text-xs text-slate-500 gap-4">
          <p>© {currentYear} IT LENS. Minden jog fenntartva.</p>
          <div class="flex gap-6">
            <a href="#" class="hover:text-slate-400 transition-colors">Adatkezelési nyilatkozat</a>
            <a href="#" class="hover:text-slate-400 transition-colors">Impresszum</a>
          </div>
        </div>
      </div>
    </footer>
  </body>
</html>
